<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 9: story camera. The preview is a mock illustration, the controls sit on top of it. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width_narrow">

        <!-- Camera preview with its controls -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_round_24"
            android:backgroundTint="@color/dark_pill"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/art_tall_green" />

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/overlay_button"
                android:contentDescription="Brightness"
                android:padding="11dp"
                android:src="@drawable/ic_sun"
                app:tint="@color/white" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/overlay_button"
                android:contentDescription="Close camera"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <!-- Gallery, flash, shutter, flip, effects -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="16dp">

                <ImageView
                    android:id="@+id/btnGallery"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_round_8"
                    android:clipToOutline="true"
                    android:contentDescription="Gallery"
                    android:padding="2dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_teal" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Flash"
                    android:padding="11dp"
                    android:src="@drawable/ic_bolt"
                    app:tint="@color/white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <!-- Shutter: translucent ring with a solid white button inside -->
                <RelativeLayout
                    android:id="@+id/btnShutter"
                    android:layout_width="84dp"
                    android:layout_height="84dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="#66FFFFFF"
                    android:clickable="true"
                    android:contentDescription="Take photo"
                    android:focusable="true">

                    <View
                        android:layout_width="66dp"
                        android:layout_height="66dp"
                        android:layout_centerInParent="true"
                        android:background="@drawable/bg_circle" />
                </RelativeLayout>

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Flip camera"
                    android:padding="11dp"
                    android:src="@drawable/ic_flip"
                    app:tint="@color/white" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <RelativeLayout
                    android:layout_width="48dp"
                    android:layout_height="48dp">

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:layout_alignParentBottom="true"
                        android:layout_alignParentStart="true"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/overlay_button"
                        android:contentDescription="Effects"
                        android:padding="11dp"
                        android:src="@drawable/ic_smile"
                        app:tint="@color/white" />

                    <View
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_react_rust" />
                </RelativeLayout>
            </LinearLayout>
        </RelativeLayout>

        <!-- Mode tabs: STORY is active -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal"
            android:paddingTop="12dp"
            android:paddingBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:letterSpacing="0.1"
                android:paddingBottom="9dp"
                android:text="TEXT"
                android:textColor="#B8B1A8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:letterSpacing="0.1"
                android:paddingBottom="9dp"
                android:text="LIVE"
                android:textColor="#B8B1A8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.1"
                    android:text="STORY"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="2dp"
                    android:layout_marginTop="6dp"
                    android:background="@color/white" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:letterSpacing="0.1"
                android:paddingBottom="9dp"
                android:text="POST"
                android:textColor="#B8B1A8"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="28dp"
                android:letterSpacing="0.1"
                android:paddingBottom="9dp"
                android:text="BOOMERANG"
                android:textColor="#B8B1A8"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
