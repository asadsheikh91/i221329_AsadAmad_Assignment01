<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 2: log in. Everything scrolls so it still works in landscape and on small phones. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width_narrow">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="28dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <!-- Language picker -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="28dp"
                android:layout_gravity="center_horizontal"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    style="@style/Kin.Text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English (UK)"
                    android:textColor="@color/text_secondary" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="4dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- App icon -->
            <ImageView
                android:layout_width="76dp"
                android:layout_height="76dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="36dp"
                android:background="@drawable/bg_round_24"
                android:backgroundTint="@color/teal"
                android:contentDescription="Kinnect logo"
                android:padding="18dp"
                android:src="@drawable/ic_logo" />

            <TextView
                style="@style/Kin.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="34dp"
                android:letterSpacing="0.08"
                android:text="RECENT LOGIN"
                android:textStyle="bold" />

            <!-- Recent login card -->
            <LinearLayout
                android:id="@+id/recentLogin"
                android:layout_width="match_parent"
                android:layout_height="81dp"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="16dp">

                <RelativeLayout
                    android:layout_width="62dp"
                    android:layout_height="62dp">

                    <TextView
                        style="@style/Kin.Avatar"
                        android:layout_width="56dp"
                        android:layout_height="56dp"
                        android:layout_alignParentBottom="true"
                        android:backgroundTint="@color/teal"
                        android:text="JW"
                        android:textSize="20sp" />

                    <TextView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_alignParentTop="true"
                        android:layout_alignParentEnd="true"
                        android:background="@drawable/bg_react_rust"
                        android:gravity="center"
                        android:includeFontPadding="false"
                        android:text="2"
                        android:textColor="@color/white"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </RelativeLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kin.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Jacob West"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="Tap to log in"
                        android:textSize="15sp" />
                </LinearLayout>

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_more"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <!-- Email field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="23dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="vertical"
                android:paddingStart="15dp"
                android:paddingEnd="15dp">

                <TextView
                    style="@style/Kin.FieldLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Mobile number or email" />

                <EditText
                    android:id="@+id/etEmail"
                    style="@style/Kin.Input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:autofillHints="emailAddress"
                    android:inputType="textEmailAddress"
                    android:text="jacob.west@mail.com" />
            </LinearLayout>

            <!-- Password field -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="59dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="15dp"
                android:paddingEnd="16dp">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kin.FieldLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password" />

                    <EditText
                        android:id="@+id/etPassword"
                        style="@style/Kin.Input"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:autofillHints="password"
                        android:inputType="textPassword"
                        android:text="kinnect2026" />
                </LinearLayout>

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:contentDescription="Show password"
                    android:src="@drawable/ic_eye"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <Button
                android:id="@+id/btnLogIn"
                style="@style/Kin.Button"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:text="Log in"
                android:textSize="18sp" />

            <TextView
                style="@style/Kin.Text.Link"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:text="Forgot password?" />

            <!-- Pushes the sign-up block to the bottom of the screen -->
            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btnCreateAccount"
                style="@style/Kin.Button.Outline"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Create new account"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_logo"
                    app:tint="@color/text_secondary" />

                <TextView
                    style="@style/Kin.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Kinnect · from SMD" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
