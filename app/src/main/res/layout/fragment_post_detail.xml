<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 5: Lina's post with the reaction picker open. Everything sits in one RelativeLayout
     so the dim layer can cover the whole page and the picker can float over the photo. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white">

            <!-- Top bar -->
            <LinearLayout
                android:id="@+id/postBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp">

                    <ImageView
                        android:id="@+id/btnBack"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="Back"
                        android:src="@drawable/ic_back"
                        app:tint="@color/text_primary" />

                    <TextView
                        style="@style/Kin.Text.Heading"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Lina's post" />
                </LinearLayout>

                <View
                    style="@style/Kin.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp" />
            </LinearLayout>

            <!-- Post header -->
            <LinearLayout
                android:id="@+id/postHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/postBar"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp">

                <TextView
                    style="@style/Kin.Avatar"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:backgroundTint="@color/avatar_purple"
                    android:text="LM"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/Kin.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/home_post_header" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Kin.Text.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="2h ·" />

                        <ImageView
                            android:layout_width="14dp"
                            android:layout_height="14dp"
                            android:layout_marginStart="4dp"
                            android:src="@drawable/ic_globe"
                            app:tint="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/postText"
                style="@style/Kin.Text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/postHeader"
                android:layout_marginTop="8dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:text="Sunset walk with the crew. Worth every grain of sand in my shoes." />

            <ImageView
                android:id="@+id/photo"
                android:layout_width="match_parent"
                android:layout_height="330dp"
                android:layout_below="@id/postText"
                android:scaleType="centerCrop"
                android:src="@drawable/art_sand" />

            <!-- Reaction and comment counts -->
            <LinearLayout
                android:id="@+id/counts"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/photo"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingTop="12dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp">

                <!-- Overlapping like / love / haha circles -->
                <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:background="@drawable/bg_react_like"
                        android:padding="5dp"
                        android:src="@drawable/ic_thumb_filled"
                        app:tint="@color/white" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="-5dp"
                        android:background="@drawable/bg_react_love"
                        android:padding="5dp"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="@color/white" />

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="-5dp"
                        android:background="@drawable/bg_react_gold"
                        android:padding="4dp"
                        android:src="@drawable/ic_face_haha" />
                </LinearLayout>

                <TextView
                    style="@style/Kin.Text.Secondary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_weight="1"
                    android:text="Aisha Khan and 1.2K others"
                    android:textSize="15sp" />

                <TextView
                    style="@style/Kin.Text.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="86 comments"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Like (already liked, so teal) / Comment / Share -->
            <LinearLayout
                android:id="@+id/actions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/counts"
                android:orientation="vertical">

                <View
                    style="@style/Kin.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="12dp"
                    android:layout_marginEnd="12dp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_like"
                            app:tint="@color/teal" />

                        <TextView
                            style="@style/Kin.Text.Link"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Like"
                            android:textStyle="normal" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_comment"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/Kin.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Comment"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="22dp"
                            android:layout_height="22dp"
                            android:src="@drawable/ic_share"
                            app:tint="@color/text_secondary" />

                        <TextView
                            style="@style/Kin.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:fontFamily="sans-serif-medium"
                            android:text="Share"
                            android:textColor="@color/text_secondary" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Comments preview -->
            <LinearLayout
                android:id="@+id/commentsSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@id/actions"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/band" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kin.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Most relevant"
                        android:textSize="18sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_marginStart="4dp"
                        android:src="@drawable/ic_chevron_down"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="12dp">

                    <TextView
                        style="@style/Kin.Avatar"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:backgroundTint="@color/avatar_crimson"
                        android:text="AK"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_18"
                        android:backgroundTint="@color/chip"
                        android:orientation="vertical"
                        android:paddingStart="12dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="12dp"
                        android:paddingBottom="8dp">

                        <TextView
                            style="@style/Kin.Text.Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Aisha Khan" />

                        <TextView
                            style="@style/Kin.Text"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="That sky is unreal." />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- Dim layer over the whole page. Tapping it closes the picker. -->
            <View
                android:id="@+id/scrim"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_alignParentTop="true"
                android:layout_alignParentBottom="true"
                android:background="@color/scrim"
                android:clickable="true"
                android:focusable="true" />

            <!-- Picker area: the pill sits at the bottom, the enlarged heart rises above it.
                 The area floats over the bottom of the photo. -->
            <RelativeLayout
                android:id="@+id/reactionPicker"
                android:layout_width="wrap_content"
                android:layout_height="116dp"
                android:layout_alignBottom="@id/photo"
                android:layout_alignParentStart="true"
                android:layout_marginStart="14dp"
                android:layout_marginBottom="-19dp">

                <!-- "Love" label above the enlarged heart -->
                <TextView
                    android:id="@+id/tvLoveTip"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="52dp"
                    android:layout_marginTop="15dp"
                    android:background="@drawable/bg_pill"
                    android:backgroundTint="@color/text_primary"
                    android:elevation="14dp"
                    android:paddingStart="10dp"
                    android:paddingTop="4dp"
                    android:paddingEnd="10dp"
                    android:paddingBottom="5dp"
                    android:text="Love"
                    android:textColor="@color/white"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <!-- The pill. The gap in the middle is where the heart sits. -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="56dp"
                    android:layout_alignParentBottom="true"
                    android:background="@drawable/bg_pill"
                    android:elevation="12dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/reactLike"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_react_like"
                        android:contentDescription="Like"
                        android:padding="8dp"
                        android:src="@drawable/ic_thumb_filled"
                        app:tint="@color/white" />

                    <View
                        android:layout_width="50dp"
                        android:layout_height="1dp" />

                    <ImageView
                        android:id="@+id/reactHaha"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_react_gold"
                        android:contentDescription="Haha"
                        android:padding="6dp"
                        android:src="@drawable/ic_face_haha" />

                    <ImageView
                        android:id="@+id/reactWow"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_react_gold"
                        android:contentDescription="Wow"
                        android:padding="6dp"
                        android:src="@drawable/ic_face_wow" />

                    <ImageView
                        android:id="@+id/reactSad"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_react_gold"
                        android:contentDescription="Sad"
                        android:padding="6dp"
                        android:src="@drawable/ic_face_sad" />

                    <ImageView
                        android:id="@+id/reactAngry"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:background="@drawable/bg_react_rust"
                        android:contentDescription="Angry"
                        android:padding="6dp"
                        android:src="@drawable/ic_face_angry" />
                </LinearLayout>

                <!-- Enlarged heart: sits in the gap, lifted above the pill, drawn over it -->
                <ImageView
                    android:id="@+id/reactLove"
                    android:layout_width="50dp"
                    android:layout_height="50dp"
                    android:layout_alignParentTop="true"
                    android:layout_marginStart="62dp"
                    android:layout_marginTop="45dp"
                    android:background="@drawable/bg_react_love"
                    android:contentDescription="Love"
                    android:elevation="14dp"
                    android:padding="12dp"
                    android:src="@drawable/ic_heart_filled"
                    app:tint="@color/white" />
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
