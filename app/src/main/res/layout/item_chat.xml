<?xml version="1.0" encoding="utf-8"?>
<!-- A plain conversation row: avatar, name and last message. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="72dp"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="16dp">

    <RelativeLayout
        android:layout_width="56dp"
        android:layout_height="56dp">

        <TextView
            android:id="@+id/tvInitials"
            style="@style/Kin.Avatar"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:textSize="22sp" />

        <!-- Green dot while the person is online (shown by ChatsActivity) -->
        <View
            android:id="@+id/onlineDot"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_alignParentEnd="true"
            android:layout_alignParentBottom="true"
            android:background="@drawable/bg_react_like"
            android:backgroundTint="@color/online"
            android:visibility="gone" />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvName"
            style="@style/Kin.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textSize="18sp" />

        <TextView
            android:id="@+id/tvPreview"
            style="@style/Kin.Text.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Teal dot for a conversation with something new in it -->
    <View
        android:id="@+id/unreadDot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="16dp"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/teal"
        android:visibility="gone" />
</LinearLayout>
