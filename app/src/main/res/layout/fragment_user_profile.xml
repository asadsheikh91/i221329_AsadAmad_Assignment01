<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 17: another person's profile (Omar Farooq). Centred layout with a ringed avatar over the cover. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Kin.Text.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Omar Farooq" />

            <ImageView
                android:id="@+id/btnSearch"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search"
                app:tint="@color/text_primary" />
        </LinearLayout>

        <View
            style="@style/Kin.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Cover photo and centred avatar -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="196dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_night" />

                    <!-- Teal outer ring, white gap, then the avatar -->
                    <RelativeLayout
                        android:layout_width="154dp"
                        android:layout_height="154dp"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="102dp"
                        android:background="@drawable/bg_circle"
                        android:backgroundTint="@color/teal"
                        android:padding="3dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_circle"
                            android:padding="3dp">

                            <TextView
                                style="@style/Kin.Avatar"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:backgroundTint="@color/avatar_green"
                                android:text="OF"
                                android:textSize="56sp" />
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>

                <TextView
                    style="@style/Kin.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:text="Omar Farooq"
                    android:textSize="28sp"
                    android:textStyle="bold" />

                <TextView
                    style="@style/Kin.Text.Secondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:gravity="center"
                    android:text="@string/friend_count_other"
                    android:textSize="16sp" />

                <TextView
                    style="@style/Kin.Text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center"
                    android:text="Night photographer. Karachi after dark." />

                <!-- Actions -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round_12"
                        android:backgroundTint="@color/teal"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_person_add"
                            app:tint="@color/white" />

                        <TextView
                            style="@style/Kin.Text.Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Add friend"
                            android:textColor="@color/white"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/btnMessage"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round_12"
                        android:backgroundTint="@color/chip"
                        android:clickable="true"
                        android:focusable="true"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_chat"
                            app:tint="@color/text_primary" />

                        <TextView
                            style="@style/Kin.Text.Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="Message"
                            android:textSize="17sp" />
                    </LinearLayout>

                    <ImageView
                        android:layout_width="44dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_round_12"
                        android:backgroundTint="@color/chip"
                        android:contentDescription="More"
                        android:padding="11dp"
                        android:src="@drawable/ic_more"
                        app:tint="@color/text_primary" />
                </LinearLayout>

                <!-- Mutual friends -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/Kin.Avatar"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:backgroundTint="@color/avatar_crimson"
                            android:text="AK"
                            android:textSize="9sp" />

                        <TextView
                            style="@style/Kin.Avatar"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="-5dp"
                            android:backgroundTint="@color/avatar_purple"
                            android:text="LM"
                            android:textSize="9sp" />

                        <TextView
                            style="@style/Kin.Avatar"
                            android:layout_width="26dp"
                            android:layout_height="26dp"
                            android:layout_marginStart="-5dp"
                            android:backgroundTint="@color/avatar_steel"
                            android:text="ZR"
                            android:textSize="9sp" />
                    </LinearLayout>

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:text="@string/mutual_friends_line"
                        android:textSize="15sp" />
                </LinearLayout>

                <View
                    style="@style/Kin.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="12dp"
                    android:layout_marginEnd="16dp" />

                <!-- Details -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_briefcase"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Kin.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/detail_work_other"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_pin"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Kin.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="@string/detail_live_other"
                        android:textSize="17sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="32dp"
                    android:layout_marginStart="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_clock"
                        app:tint="@color/text_secondary" />

                    <TextView
                        style="@style/Kin.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Joined June 2017"
                        android:textSize="17sp" />
                </LinearLayout>

                <!-- Photos -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="16dp"
                    android:layout_marginEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kin.Text.Heading"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Photos" />

                    <TextView
                        style="@style/Kin.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="16dp"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="116dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round_12"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_night" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="116dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round_12"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_lilac" />

                    <ImageView
                        android:layout_width="0dp"
                        android:layout_height="116dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_round_12"
                        android:clipToOutline="true"
                        android:scaleType="centerCrop"
                        android:src="@drawable/art_blue" />
                </LinearLayout>
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
