<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 10: story editor. Tools at the top, a sticker on the photo, share targets at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width_narrow">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_margin="8dp"
            android:layout_weight="1"
            android:background="@drawable/bg_round_24"
            android:backgroundTint="@color/dark_pill"
            android:clipToOutline="true">

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/art_tall_green" />

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_alignParentStart="true"
                android:layout_alignParentTop="true"
                android:layout_margin="10dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/overlay_button"
                android:contentDescription="Close editor"
                android:padding="11dp"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />

            <!-- Editing tools -->
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_alignParentEnd="true"
                android:layout_margin="10dp"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Tag people"
                    android:padding="11dp"
                    android:src="@drawable/ic_person_add"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:gravity="center"
                    android:text="Aa"
                    android:textColor="@color/white"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Stickers"
                    android:padding="11dp"
                    android:src="@drawable/ic_smile"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Music"
                    android:padding="11dp"
                    android:src="@drawable/ic_music"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/overlay_button"
                    android:contentDescription="Effects"
                    android:padding="11dp"
                    android:src="@drawable/ic_sparkle"
                    app:tint="@color/white" />
            </LinearLayout>

            <!-- Text sticker, tilted a few degrees -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="32dp"
                android:layout_marginTop="158dp"
                android:background="@drawable/bg_round_12"
                android:backgroundTint="@color/rust"
                android:paddingStart="14dp"
                android:paddingTop="8dp"
                android:paddingEnd="14dp"
                android:paddingBottom="10dp"
                android:rotation="3"
                android:text="Saturday plans"
                android:textColor="@color/white"
                android:textSize="24sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Share targets -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="14dp">

            <LinearLayout
                android:id="@+id/btnYourStory"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/dark_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <TextView
                    style="@style/Kin.Avatar"
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:backgroundTint="@color/teal"
                    android:text="JW"
                    android:textSize="10sp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Your story"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:background="@drawable/bg_pill"
                android:backgroundTint="@color/dark_pill"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="26dp"
                    android:layout_height="26dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/online"
                    android:padding="6dp"
                    android:src="@drawable/ic_star"
                    app:tint="@color/white" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Close friends"
                    android:textColor="@color/white"
                    android:textSize="17sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <ImageView
                android:id="@+id/btnShare"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/teal"
                android:contentDescription="Share to your story"
                android:padding="13dp"
                android:src="@drawable/ic_arrow_right"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
