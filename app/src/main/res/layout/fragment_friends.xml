<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 14: friends. Friend requests with Confirm / Delete, then people you may know. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                style="@style/Kin.Text.Title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Friends"
                android:textSize="26sp" />

            <ImageView
                android:id="@+id/btnSearch"
                style="@style/Kin.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />
        </LinearLayout>

        <!-- Five-tab bar, friends is active -->
        <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_height"
                android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Home"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_home" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabFriends"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Friends"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_friends"
                    app:tint="@color/teal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/teal" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabMarketplace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Marketplace"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_marketplace" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabNotifications"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Notifications"
                android:clickable="true"
                android:focusable="true">

                <ImageView android:id="@+id/tabBellIcon"
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_notification" />

                <!-- Unread count on the bell -->
                <TextView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_alignTop="@id/tabBellIcon"
                    android:layout_marginStart="-9dp"
                    android:layout_marginTop="-6dp"
                    android:layout_toEndOf="@id/tabBellIcon"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/rust"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_menu" />
            </RelativeLayout>

            </LinearLayout>

            <View
                style="@style/Kin.Divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="24dp">

                <!-- Suggestions / Your friends -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="14dp"
                    android:paddingEnd="16dp">

                    <TextView
                        style="@style/Kin.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Suggestions" />

                    <TextView
                        style="@style/Kin.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:layout_marginStart="8dp"
                        android:background="@drawable/bg_chip"
                        android:gravity="center"
                        android:paddingStart="16dp"
                        android:paddingEnd="16dp"
                        android:text="Your friends" />
                </LinearLayout>

                <!-- Friend requests -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="4dp">

                    <TextView
                        style="@style/Kin.Text.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Friend requests"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Kin.Text.Title"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_weight="1"
                        android:text="12"
                        android:textColor="@color/rust"
                        android:textSize="22sp" />

                    <TextView
                        style="@style/Kin.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="See all" />
                </LinearLayout>

                <include
                    android:id="@+id/requestSara"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/requestBilal"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/requestNoor"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/requestDaniyal"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <View
                    style="@style/Kin.Divider"
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="6dp"
                    android:layout_marginEnd="16dp" />

                <TextView
                    style="@style/Kin.Text.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_marginTop="14dp"
                    android:layout_marginBottom="4dp"
                    android:text="People you may know"
                    android:textSize="22sp" />

                <include
                    android:id="@+id/suggestOmarS"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <include
                    android:id="@+id/suggestOmarT"
                    layout="@layout/item_friend"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
