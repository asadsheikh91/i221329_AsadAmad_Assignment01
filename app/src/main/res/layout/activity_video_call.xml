<?xml version="1.0" encoding="utf-8"?>
<!-- Video call: the other person fills the screen, our own camera sits in the corner. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_bg">

    <!-- The other person -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/remoteView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Shown until the first remote frame arrives -->
    <LinearLayout
        android:id="@+id/placeholder"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/teal"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCallInitials"
            style="@style/Kin.Avatar"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:backgroundTint="@color/avatar_purple"
            android:text="K"
            android:textSize="60sp" />
    </LinearLayout>

    <!-- Our own camera -->
    <org.webrtc.SurfaceViewRenderer
        android:id="@+id/localView"
        android:layout_width="108dp"
        android:layout_height="152dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="88dp"
        android:layout_marginEnd="16dp" />

    <!-- Name and status -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/bg_overlay"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="40dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp">

        <TextView
            android:id="@+id/tvCallName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Kinnect user"
            android:textColor="@color/white"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvCallStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Calling..."
            android:textColor="@color/white"
            android:textSize="17sp" />
    </LinearLayout>

    <!-- Controls: flip camera, camera on/off, accept (incoming only), mute, hang up -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingStart="16dp"
        android:paddingTop="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="36dp">

        <ImageView
            android:id="@+id/btnSwitchCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/overlay_button"
            android:contentDescription="Switch camera"
            android:padding="15dp"
            android:src="@drawable/ic_flip"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnCamera"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/overlay_button"
            android:contentDescription="Turn camera on or off"
            android:padding="15dp"
            android:src="@drawable/ic_video_call"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnMute"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/overlay_button"
            android:contentDescription="Mute"
            android:padding="15dp"
            android:src="@drawable/ic_mic"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnAccept"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/online"
            android:contentDescription="Accept"
            android:padding="18dp"
            android:src="@drawable/ic_video_call"
            android:visibility="gone"
            app:tint="@color/white" />

        <ImageView
            android:id="@+id/btnEndCall"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginStart="14dp"
            android:background="@drawable/bg_circle"
            android:backgroundTint="@color/call_red"
            android:contentDescription="End call"
            android:padding="18dp"
            android:src="@drawable/ic_end_call" />
    </LinearLayout>
</FrameLayout>
