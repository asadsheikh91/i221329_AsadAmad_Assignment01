<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 4: home feed. Header and tabs stay put, composer / stories / post scroll. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- Header: wordmark, search, chats -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:letterSpacing="-0.02"
                android:text="kinnect"
                android:textColor="@color/teal"
                android:textSize="28sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnSearch"
                style="@style/Kin.IconButton"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="Search"
                android:src="@drawable/ic_search" />

            <RelativeLayout
                android:id="@+id/btnChats"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginStart="6dp"
                android:clickable="true"
                android:contentDescription="Chats"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.IconButton"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_alignParentStart="true"
                    android:layout_alignParentBottom="true"
                    android:src="@drawable/ic_chat" />

                <TextView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:background="@drawable/bg_react_rust"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>
        </LinearLayout>

        <!-- Five-tab bar, home is active -->
        <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/tab_height"
                android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/tabHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Home"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_home"
                    app:tint="@color/teal" />

                <View
                    android:layout_width="match_parent"
                    android:layout_height="3dp"
                    android:layout_alignParentBottom="true"
                    android:background="@color/teal" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabFriends"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Friends"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_friends" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabMarketplace"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Marketplace"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_marketplace" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabNotifications"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Notifications"
                android:clickable="true"
                android:focusable="true">

                <ImageView android:id="@+id/tabBellIcon"
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_notification" />

                <!-- Unread count on the bell -->
                <TextView
                    android:layout_width="17dp"
                    android:layout_height="17dp"
                    android:layout_alignTop="@id/tabBellIcon"
                    android:layout_marginStart="-9dp"
                    android:layout_marginTop="-6dp"
                    android:layout_toEndOf="@id/tabBellIcon"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/rust"
                    android:gravity="center"
                    android:includeFontPadding="false"
                    android:text="5"
                    android:textColor="@color/white"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/tabMenu"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:contentDescription="Menu"
                android:clickable="true"
                android:focusable="true">

                <ImageView
                    style="@style/Kin.TabIcon"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:layout_centerInParent="true"
                    android:src="@drawable/ic_menu" />
            </RelativeLayout>

            </LinearLayout>

            <View
                style="@style/Kin.Divider"
                android:layout_width="match_parent"
                android:layout_height="1dp" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingBottom="16dp">

                <!-- Composer -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="10dp">

                    <TextView
                        android:id="@+id/composerAvatar"
                        style="@style/Kin.Avatar"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:backgroundTint="@color/teal"
                        android:text="JW"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/tvComposerHint"
                        style="@style/Kin.Text"
                        android:layout_width="0dp"
                        android:layout_height="41dp"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:background="@drawable/bg_pill_field"
                        android:gravity="center_vertical"
                        android:paddingStart="16dp"
                        android:text="What's on your mind, Jacob?"
                        android:textColor="@color/text_secondary" />

                    <ImageView
                        android:id="@+id/btnComposerPhoto"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:layout_marginStart="14dp"
                        android:contentDescription="Add photo"
                        android:src="@drawable/ic_gallery"
                        app:tint="@color/teal" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/band" />

                <!-- Stories. The row is simply cut off at the screen edge, like in the design. -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingStart="16dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="12dp">

                    <!-- Create story -->
                    <RelativeLayout
                        android:id="@+id/storyCreate"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:background="@drawable/bg_card"
                        android:clipToOutline="true">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="119dp"
                            android:background="@color/teal_tint" />

                        <TextView
                            style="@style/Kin.Avatar"
                            android:layout_width="64dp"
                            android:layout_height="64dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="28dp"
                            android:backgroundTint="@color/teal"
                            android:text="JW"
                            android:textSize="24sp" />

                        <RelativeLayout
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_alignParentTop="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="102dp"
                            android:background="@drawable/bg_circle">

                            <ImageView
                                android:layout_width="28dp"
                                android:layout_height="28dp"
                                android:layout_centerInParent="true"
                                android:background="@drawable/bg_circle"
                                android:backgroundTint="@color/teal"
                                android:padding="7dp"
                                android:src="@drawable/ic_add"
                                app:tint="@color/white" />
                        </RelativeLayout>

                        <TextView
                            style="@style/Kin.Text.Name"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentBottom="true"
                            android:layout_centerHorizontal="true"
                            android:layout_marginBottom="12dp"
                            android:text="Create story"
                            android:textSize="14sp" />
                    </RelativeLayout>

                    <!-- The other stories share one layout; HomeActivity fills each one in -->
                    <include
                        android:id="@+id/storyOmar"
                        layout="@layout/item_story"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp" />
                    <include
                        android:id="@+id/storySara"
                        layout="@layout/item_story"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp" />
                    <include
                        android:id="@+id/storyHamza"
                        layout="@layout/item_story"
                        android:layout_width="104dp"
                        android:layout_height="176dp"
                        android:layout_marginStart="8dp" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:background="@color/band" />

                <include layout="@layout/item_post" />
            </LinearLayout>
        </ScrollView>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
