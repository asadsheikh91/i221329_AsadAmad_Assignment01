<?xml version="1.0" encoding="utf-8"?>
<!-- Screen 6: comments with threaded replies. The reply bar stays at the bottom. -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintWidth_max="@dimen/content_max_width">

        <!-- Top bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Back"
                android:src="@drawable/ic_back"
                app:tint="@color/text_primary" />

            <TextView
                style="@style/Kin.Text.Heading"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:text="Comments" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:background="@drawable/bg_chip"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="14dp"
                android:paddingEnd="10dp">

                <TextView
                    style="@style/Kin.Text.Name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Most relevant"
                    android:textSize="15sp" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:layout_marginStart="2dp"
                    android:src="@drawable/ic_chevron_down"
                    app:tint="@color/text_primary" />
            </LinearLayout>
        </LinearLayout>

        <View
            style="@style/Kin.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <!-- Who reacted -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Overlapping like / love / haha circles -->
            <LinearLayout xmlns:app="http://schemas.android.com/apk/res-auto"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:background="@drawable/bg_react_like"
                    android:padding="5dp"
                    android:src="@drawable/ic_thumb_filled"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-5dp"
                    android:background="@drawable/bg_react_love"
                    android:padding="5dp"
                    android:src="@drawable/ic_heart_filled"
                    app:tint="@color/white" />

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:layout_marginStart="-5dp"
                    android:background="@drawable/bg_react_gold"
                    android:padding="4dp"
                    android:src="@drawable/ic_face_haha" />
            </LinearLayout>

            <TextView
                style="@style/Kin.Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:layout_weight="1"
                android:text="1.2K"
                android:textColor="@color/text_primary"
                android:textSize="15sp" />

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/text_secondary" />
        </LinearLayout>

        <View
            style="@style/Kin.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <!-- Comment 1: Aisha Khan -->
                <include
                    android:id="@+id/commentAisha"
                    layout="@layout/item_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content" />

                <!-- Reaction chip, pulled up so it overlaps the bubble's bottom edge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="26dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="-13dp"
                    android:layout_marginEnd="1dp"
                    android:background="@drawable/bg_pill"
                    android:elevation="2dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="4dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:background="@drawable/bg_react_like"
                        android:padding="4dp"
                        android:src="@drawable/ic_thumb_filled"
                        app:tint="@color/white" />

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_marginStart="-4dp"
                        android:background="@drawable/bg_react_love"
                        android:padding="4dp"
                        android:src="@drawable/ic_heart_filled"
                        app:tint="@color/white" />

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:text="24" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="72dp"
                    android:layout_marginTop="-7dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="2h" />

                    <TextView
                        style="@style/Kin.Text.Link"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Like"
                        android:textSize="14sp" />

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Reply"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Reply 1: Lina Marsh. The vertical line runs down the left; each reply adds a curved branch. -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="33dp"
                        android:background="@color/border" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="32dp"
                        android:src="@drawable/ic_thread_branch" />

                    <TextView
                        android:id="@+id/avatarLina"
                        style="@style/Kin.Avatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="7dp"
                        android:backgroundTint="@color/avatar_purple"
                        android:text="LM"
                        android:textSize="11sp" />

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="96dp"
                        android:layout_marginTop="7dp">

                        <LinearLayout
                            android:id="@+id/bubbleLina"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/bg_round_18"
                            android:backgroundTint="@color/chip"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                style="@style/Kin.Text.Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Lina Marsh" />

                            <TextView
                                style="@style/Kin.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Near the old pier, right before the rain started!" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="26dp"
                            android:layout_alignBottom="@id/bubbleLina"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="1dp"
                            android:layout_marginBottom="-13dp"
                            android:background="@drawable/bg_pill"
                            android:elevation="2dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="4dp"
                            android:paddingEnd="8dp">

                            <ImageView
                                android:layout_width="18dp"
                                android:layout_height="18dp"
                                android:background="@drawable/bg_react_gold"
                                android:padding="3dp"
                                android:src="@drawable/ic_face_haha" />

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="4dp"
                                android:text="3" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/bubbleLina"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:paddingBottom="12dp">

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="1h" />

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Like"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Reply"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </RelativeLayout>
                </RelativeLayout>

                <!-- Reply 2: Zain Raza -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <View
                        android:layout_width="2dp"
                        android:layout_height="match_parent"
                        android:layout_marginStart="33dp"
                        android:background="@color/border" />

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="32dp"
                        android:src="@drawable/ic_thread_branch" />

                    <TextView
                        style="@style/Kin.Avatar"
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="7dp"
                        android:backgroundTint="@color/avatar_steel"
                        android:text="ZR"
                        android:textSize="11sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="96dp"
                        android:layout_marginTop="7dp"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="16dp"
                            android:background="@drawable/bg_round_18"
                            android:backgroundTint="@color/chip"
                            android:orientation="vertical"
                            android:paddingStart="12dp"
                            android:paddingTop="8dp"
                            android:paddingEnd="12dp"
                            android:paddingBottom="8dp">

                            <TextView
                                style="@style/Kin.Text.Name"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Zain Raza" />

                            <TextView
                                style="@style/Kin.Text"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/comment_mention" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:layout_marginTop="6dp"
                            android:orientation="horizontal"
                            android:paddingBottom="12dp">

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="45m" />

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Like"
                                android:textStyle="bold" />

                            <TextView
                                style="@style/Kin.Text.Secondary"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="14dp"
                                android:text="Reply"
                                android:textStyle="bold" />
                        </LinearLayout>
                    </LinearLayout>
                </RelativeLayout>

                <!-- View more replies: the line ends in a final curve -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="22dp"
                        android:layout_marginStart="32dp"
                        android:src="@drawable/ic_thread_branch" />

                    <TextView
                        style="@style/Kin.Text.Name"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="60dp"
                        android:layout_marginTop="10dp"
                        android:text="View 6 more replies"
                        android:textColor="@color/text_secondary" />
                </RelativeLayout>

                <!-- Comment 2: Hamza Ali, with a photo -->
                <include
                    android:id="@+id/commentHamza"
                    layout="@layout/item_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp" />

                <ImageView
                    android:layout_width="180dp"
                    android:layout_height="124dp"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="6dp"
                    android:background="@drawable/bg_round_12"
                    android:clipToOutline="true"
                    android:scaleType="centerCrop"
                    android:src="@drawable/art_blue" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="60dp"
                    android:layout_marginTop="6dp"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1h" />

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Like"
                        android:textStyle="bold" />

                    <TextView
                        style="@style/Kin.Text.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:text="Reply"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Comment 3: Maya Chen -->
                <include
                    android:id="@+id/commentMaya"
                    layout="@layout/item_comment"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp" />
            </LinearLayout>
        </ScrollView>

        <!-- Reply bar -->
        <View
            style="@style/Kin.Divider"
            android:layout_width="match_parent"
            android:layout_height="1dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingTop="10dp"
            android:paddingEnd="16dp"
            android:paddingBottom="6dp">

            <TextView
                style="@style/Kin.Text.Secondary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/comments_replying_to"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/btnCancelReply"
                style="@style/Kin.Text.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cancel"
                android:textSize="15sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:paddingBottom="10dp">

            <ImageView
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Add photo"
                android:src="@drawable/ic_camera"
                app:tint="@color/teal" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginStart="18dp"
                android:layout_weight="1"
                android:background="@drawable/bg_search"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="10dp">

                <EditText
                    style="@style/Kin.Input"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:hint="Write a reply…"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:textSize="17sp" />

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_smile"
                    app:tint="@color/text_secondary" />
            </LinearLayout>

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginStart="8dp"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/teal"
                android:contentDescription="Send"
                android:padding="10dp"
                android:src="@drawable/ic_send"
                app:tint="@color/white" />
        </LinearLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
