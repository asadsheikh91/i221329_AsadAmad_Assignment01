rules_version = '2';

// Paste this into Firebase console > Firestore Database > Rules, then Publish.
// Everything requires a signed-in user, and people can only touch their own data.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // True when the only difference between two lists is the signed-in user's own uid
    // (added or removed). Used for likes, "seen by" and friend lists.
    function changesOnlyMine(newList, oldList) {
      return newList.toSet().difference(oldList.toSet()).difference([request.auth.uid].toSet()).size() == 0
        && oldList.toSet().difference(newList.toSet()).difference([request.auth.uid].toSet()).size() == 0;
    }

    // Profiles: any signed-in user can look people up, but only edit their own.
    // The one exception is the list of friends: when a friendship is accepted or ended,
    // the other person's list may gain or lose the signed-in user, and nothing else.
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid;
      allow update: if signedIn() && (
        request.auth.uid == uid
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['friends'])
            && changesOnlyMine(request.resource.data.friends, resource.data.friends)));
    }

    // Cover photo: everyone signed in can see it, only the owner can change it.
    match /users/{uid}/media/{mediaId} {
      allow read: if signedIn();
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // Phone number and gender: private to the owner.
    match /users/{uid}/private/{detailId} {
      allow read, write: if signedIn() && request.auth.uid == uid;
    }

    // Notifications: only the person they are for can read them. The sender writes them
    // (and may refresh or take back their own), the receiver can mark them read or delete them.
    match /notifications/{noticeId} {
      allow read: if signedIn() && resource.data.toUid == request.auth.uid;
      allow create: if signedIn()
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid != request.auth.uid;
      allow update: if signedIn() && (
        (resource.data.toUid == request.auth.uid
         && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']))
        || (resource.data.fromUid == request.auth.uid
            && request.resource.data.fromUid == request.auth.uid
            && request.resource.data.toUid == resource.data.toUid));
      allow delete: if signedIn()
        && (resource.data.toUid == request.auth.uid || resource.data.fromUid == request.auth.uid);
    }

    // Stories: everyone signed in can read them (the app only shows friends' stories).
    // Anyone may add or remove their own uid in "seen by" and "liked by"; only the author can delete.
    match /stories/{storyId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewedBy', 'likedBy'])
        && changesOnlyMine(request.resource.data.viewedBy, resource.data.viewedBy)
        && changesOnlyMine(request.resource.data.likedBy, resource.data.likedBy);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      // The full size picture
      match /data/{imageId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Marketplace: everyone signed in can read listings; the seller can mark one sold or delete it.
    match /listings/{listingId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.sellerId == request.auth.uid;
      allow update: if signedIn()
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sold']);
      allow delete: if signedIn() && resource.data.sellerId == request.auth.uid;
    }

    // Friend requests. The id is "<uidA>_<uidB>" (sorted), so it says who may open it.
    match /friendships/{pair} {
      allow get: if signedIn() && request.auth.uid in pair.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.users;
      allow create: if signedIn()
        && request.resource.data.from == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.users.hasAll(pair.split('_'))
        && request.resource.data.users.size() == 2;
      // Only the person who received the request may accept it
      allow update: if signedIn()
        && resource.data.to == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && request.resource.data.status == 'accepted';
      // Decline, cancel or unfriend
      allow delete: if signedIn() && request.auth.uid in resource.data.users;
    }

    // Conversations: only the two people in them.
    match /chats/{chatId} {
      allow get: if signedIn() && request.auth.uid in chatId.split('_');
      allow list: if signedIn() && request.auth.uid in resource.data.members;
      allow create, update: if signedIn()
        && request.auth.uid in chatId.split('_')
        && request.resource.data.members.hasAll(chatId.split('_'))
        && request.resource.data.members.size() == 2;

      match /messages/{messageId} {
        allow read: if signedIn() && request.auth.uid in chatId.split('_');
        allow create: if signedIn()
          && request.auth.uid in chatId.split('_')
          && request.resource.data.sender == request.auth.uid;
      }
    }

    // Posts: everyone signed in can read them. Anyone may like (add or remove only their own uid)
    // and comment (which bumps commentCount); only the author can delete.
    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn()
        && request.resource.data.authorId == request.auth.uid
        && request.resource.data.likedBy.size() == 0
        && request.resource.data.commentCount == 0;
      allow update: if signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedBy', 'commentCount', 'reactions'])
        && changesOnlyMine(request.resource.data.likedBy, resource.data.likedBy)
        // reactions: person's uid -> Like, Love, Haha ...; only the signed-in user's own entry may change
        && request.resource.data.get('reactions', {}).diff(resource.data.get('reactions', {}))
             .affectedKeys().hasOnly([request.auth.uid]);
      allow delete: if signedIn() && resource.data.authorId == request.auth.uid;

      match /comments/{commentId} {
        allow read: if signedIn();
        allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
        allow delete: if signedIn() && resource.data.authorId == request.auth.uid;
      }
    }

    // Calls: the WebRTC set-up messages between the two phones (see WebRtcCall.kt).
    match /calls/{callId} {
      allow create: if signedIn() && request.resource.data.callerId == request.auth.uid;
      // resource == null lets the caller start listening before the document exists
      allow get: if signedIn()
        && (resource == null
            || resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);
      // Incoming-call watcher: calls addressed to me
      allow list: if signedIn() && resource.data.calleeId == request.auth.uid;
      allow update: if signedIn()
        && (resource.data.callerId == request.auth.uid
            || resource.data.calleeId == request.auth.uid);

      // callerCandidates and calleeCandidates
      match /{side}/{candidateId} {
        allow read, create: if signedIn()
          && (get(/databases/$(database)/documents/calls/$(callId)).data.callerId == request.auth.uid
              || get(/databases/$(database)/documents/calls/$(callId)).data.calleeId == request.auth.uid);
      }
    }
  }
}
